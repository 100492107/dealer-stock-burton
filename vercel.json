{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(vehicles|images_map|overrides).json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/sync-stock", "schedule": "0 8 * * *" },
    { "path": "/api/sync-stock", "schedule": "0 9 * * *" },
    { "path": "/api/sync-stock", "schedule": "0 12 * * *" },
    { "path": "/api/sync-stock", "schedule": "0 17 * * *" },
    { "path": "/api/sync-stock", "schedule": "0 18 * * *" }
  ]
}
