{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(vehicles|images_map|overrides|sold_cars).json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/sync-stock.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/sync-stock", "schedule": "0 9 * * *" },
    { "path": "/api/sync-stock", "schedule": "0 18 * * *" }
  ]
}
